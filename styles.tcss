Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 3fr;
}

#dir {
    height: 100%;
    border: solid #fce703c3;
    border-title-color: #fce803;
    align: center top;
}

#tracklist {
    height: 100%;
    border: solid #fce703c3;
    border-title-color: #fce803;
}

#player_bar {
    dock: bottom;
    border: solid #fce703c3;
    border-title-color: #fce803;
}

.button {
    background: #fce803;
    color: black;
    border: none;
    width: auto;
    min-width: 8;
    margin: 0 1;
}