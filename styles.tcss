Screen {
    layout: grid;
    grid-size: 2;
    grid-columns: 1.5fr 3fr;
}

#dir {
    height: 100%;
    border: solid #fce703c3;
    border-title-color: #fce803;
    align: center top;
}

#buttons {
    width: 100%;
    height: auto;
    align: center middle;
}

#directory_listing {
    width: 100%;
    height: 1fr;
}

#tracklist {
    height: 100%;
    border: solid #fce703c3;
    border-title-color: #fce803;
}

#player_bar {
    dock: bottom;
    border: solid #fce703c3;
    border-title-color: #fce803;
}

.button_dir {
    background: #fce803;
    color: black;
    border: none;
    width: auto;
    min-width: 10;
    margin: 0 1 0 0;
    align: center top;
    text-align: center;
}